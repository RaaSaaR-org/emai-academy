# EmAI Academy: environment for skills-ms-rooms (release/2026-09 worktree) on :8011.
# scripts/lib.sh turns this file plus the checkout-dependent paths into .run/skills-ms.env, which
#  - scripts/dev-up.sh sources into the process env (set -a; . file; set +a), and
#  - skills-ms-rooms/.env points to (symlink), so poe tasks (poe api, poe migrate) load the same values.
# Bash-like quoting (single-quote JSON values), no $VAR expansion: works as a poe envfile and in sh.

LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8011
ROOT_PATH=/skills

# CORS is only added when DEBUG=True, and the frontend on :3001 calls the gateway :8191 cross-origin.
DEBUG=True
RELOAD=False

CACHE_TTL=300

# Must equal [jwt] secret in config/backend.toml
JWT_SECRET=emai-dev-secret
INTERNAL_JWT_SECRET_AUTH=
INTERNAL_JWT_SECRET_SHOP=
INTERNAL_JWT_SECRET_SKILLS=
INTERNAL_JWT_TTL=10

# The client appends /_internal/..., and the backend serves it under /auth and /shop.
AUTH_URL=http://127.0.0.1:8081/auth
SHOP_URL=http://127.0.0.1:8081/shop
# challenges-ms is not running, so the "exercise" room kind returns 503. Don't use it.
CHALLENGES_URL=http://127.0.0.1:8005

# Learning rooms and EmAI content. The content paths (COURSES, LEARNING_ROOMS_CONTENT,
# CHARACTER_AREAS, MP4_LECTURES and the optional PRIVATE_* overlays) must be absolute, so they
# are NOT set here: scripts/lib.sh appends them, computed from the checkout location, when it
# generates .run/skills-ms.env (the file skills-ms actually reads). Content changes need a restart
# (scripts/reload-content.sh).
ROOMS_ENABLED=True
LESSON_MODULE_ORIGINS='["http://localhost:3001"]'
LESSON_MODULE_LOCAL_DEVELOPMENT=True

LECTURE_XP=10
PUBLIC_BASE_URL=http://127.0.0.1:8191/skills

# Shared smtp4dev (UI http://localhost:5050)
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
SMTP_USER=academy
SMTP_PASSWORD=academy
SMTP_FROM="EmAI Academy DEV <academy@emai.dev>"
SMTP_TLS=False
SMTP_STARTTLS=False

DATABASE_URL=postgresql+asyncpg://academy@127.0.0.1:5432/emai_skills
POOL_RECYCLE=300
POOL_SIZE=5
MAX_OVERFLOW=10
SQL_SHOW_STATEMENTS=False

# Bootstrap uses Valkey db 0 (backend) and db 1 (skills). skills-ms flushes func_cache:courses:* on startup,
# so it gets its own db. AUTH_REDIS_URL must equal the EmAI backend [cache] url (db 2).
REDIS_URL=redis://127.0.0.1:6379/3
AUTH_REDIS_URL=redis://127.0.0.1:6379/2
