# EmAI Academy skills-ms: production environment reference (image emai-academy-skills).
# Values baked into the image are listed as "(image default)"; the deployer sets the rest.
# SECRET marks values that come from the emai-academy-secrets Secret.

# --- set by the deployer ----------------------------------------------------------
# SECRET: must equal the backend [jwt] secret (ACADEMY_JWT_SECRET)
JWT_SECRET=<JWT_SECRET>
# SECRET (contains POSTGRES_PASSWORD; keep the password URL-safe)
DATABASE_URL=postgresql+asyncpg://academy:<POSTGRES_PASSWORD>@emai-academy-postgres:5432/emai_skills
REDIS_URL=redis://emai-academy-valkey:6379/1
# Must equal the backend [cache] url (logout revocation keys)
AUTH_REDIS_URL=redis://emai-academy-valkey:6379/0
# The client appends /_internal/...; the backend serves those under /auth and /shop.
AUTH_URL=http://emai-academy-backend:8081/auth
SHOP_URL=http://emai-academy-backend:8081/shop
PUBLIC_BASE_URL=https://academy.emai.dev/api/skills
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_RECYCLE=300
CACHE_TTL=300
LECTURE_XP=10

# --- image defaults (override only with a reason) -------------------------------------
# HOST=0.0.0.0  PORT=8011  ROOT_PATH=/skills  DEBUG=False  RELOAD=False  LOG_LEVEL=INFO
# ROOMS_ENABLED=True
# COURSES=/content/courses
# LEARNING_ROOMS_CONTENT=/content/learning_rooms.json
# CHARACTER_AREAS=/content/character_areas.json
# MP4_LECTURES=/content/lectures
# LESSON_MODULE_ORIGINS='["https://academy.emai.dev"]'   (must match the web image PUBLIC_ORIGIN)
# LESSON_MODULE_LOCAL_DEVELOPMENT=False                  (prod modules must be served over HTTPS)
# RUN_MIGRATIONS=true                                   (entrypoint `serve` runs alembic upgrade head)

# --- not used by EmAI ------------------------------------------------------------------
# CHALLENGES_URL (no challenges-ms; the "exercise" room kind is not used)
# SMTP_* (skills-ms only mails purchase receipts; every EmAI course is free)
# INTERNAL_JWT_SECRET_* (empty = fall back to JWT_SECRET, as in the backend)
